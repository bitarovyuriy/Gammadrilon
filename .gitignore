# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Build folders
build/
dist/
out/

# PyInstaller
*.spec
!Gammadrilon.spec
!Gammadrilon-onefile.spec

# Logs
*.log

# User/local config
presets.json
# копия, которую делает импорт настроек (см. «Утилиты» → экспорт/импорт)
presets.before-import.json

# IDE/editor files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.bak
*.old

# Installer artifacts
*.msi
*.zip
*.7z
*.rar

# Отладочные пробы автора в корне проекта: не код продукта, в сборку не попадают.
# Здесь были две строки с именами в битой кодировке — их заменил этот шаблон.
_tmp_*.py

# Рантайм-файлы локального API: рядом с приложением, но не в репозитории
# (agent_token.txt — секрет доступа, ему в git нельзя).
agent_token.txt
agent_api.json
agent_audit.jsonl

# Инструменты разработки
.ruff_cache/
.pytest_cache/
